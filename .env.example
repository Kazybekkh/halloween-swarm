# Copy to .env and fill in. Never commit .env.
TEAM_HANDLE="team-your-handle"        # lowercase, digits, dashes; 2-32 chars (the feed rejects capitals)

YDC_API_KEY=""                        # You.com: https://you.com/home -> API key (X-API-Key header)
PARASAIL_API_KEY=""                   # Parasail: https://www.saas.parasail.io/keys
ONE_API_KEY=""                        # One: https://app.withone.ai/settings/api-keys (sk_live_...)
ONE_CONNECTION_KEYS=""                # optional allowlist, e.g. live::discord::default::<32hex>
OPENAI_API_KEY=""                     # OpenAI: false-alarm veto (Decisions API)

SCENARIO_MCP="https://api.you.com/mcp/halloween-hack-26"
DISCORD_CHANNEL_ID="1564842098740695100"   # #loft-incident

# Decisions API thresholds (see DESIGN.md)
TRIAGE_SKIP_BELOW="0.15"
VETO_MIN_PROB="0.5"

# Parasail model and rate limit (free tier 5 RPM; paid 500)
PARASAIL_MODEL="parasail-deepseek-v4-flash"
PARASAIL_RPM="5"
# Deterministic rule check
RULE_EMF_MIN="30"
RULE_TEMP_MAX_C="5"
RULE_SIGHTING_MIN_CONF="0.5"
RULE_MIN_SIGNALS="2"
